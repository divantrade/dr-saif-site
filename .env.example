# ─── Sanity configuration ────────────────────────────────────────────────────
# Copy this file to .env.local (which is gitignored) and fill in real values.
# NEVER commit .env.local — it contains secrets.

# Publicly exposed values (safe for client-side).
NEXT_PUBLIC_SANITY_PROJECT_ID=qgv6yxcl
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-04-12

# Server-only write token — used by scripts/migrate-to-sanity.ts and any
# webhook handlers. Create one in Sanity → API → Tokens with Editor permission.
# NEVER commit or expose to the browser.
SANITY_WRITE_TOKEN=

# Optional: separate read token if you want to preview drafts on the site.
SANITY_READ_TOKEN=

# Webhook secret for Sanity -> Vercel revalidation (set this later when
# wiring up the deploy hook).
SANITY_WEBHOOK_SECRET=
